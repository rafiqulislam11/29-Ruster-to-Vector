# CreativeForge AI Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Authentication & Security
AUTH_SECRET=creativeforge_super_secret_session_key_2026_xyz
SESSION_EXPIRY=7d

# Database
DATABASE_PATH=./data/creativeforge.db

# Storage
STORAGE_DRIVER=local # Options: local, s3, cdn
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# AI Provider Configuration
# Supported: mock, replicate, stability, custom
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=your_replicate_or_stability_api_key_here
AI_PROVIDER_ENDPOINT=https://api.replicate.com/v1

# Automated Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./storage/backups

# Payment & Monetization
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
